# Rock Paper Scissor

import random

emojis = { 'r':'🪨', 'p':'📄', 's':'✂️'} # emojis can be added by pressing ctrl+cmd+space on Mac
choices = ('r', 'p', 's')


while True:
    user_input = input(' r / p / s ').lower()
    if user_input not in choices:
     print('invalida choisaa')
     continue

    computer_played = random.choice(choices)

    print(f'you chose {emojis[user_input]}')
    print(f'computer chose {emojis[computer_played]}')
  
    
    if user_input == computer_played:
        print('draw')

    elif (
        (user_input == 'r' and computer_played == 'p') or
        (user_input == 'p' and computer_played == 's') or
        (user_input == 's' and computer_played == 'r')):
        print('computer wins')    

    else:
        print('user wins')   

    should_continue = input(' Do you want to continue (Y/N) ?').lower()

    if should_continue == 'n':
       break
       
     
    

