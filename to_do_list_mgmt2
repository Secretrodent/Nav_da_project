import json

file_name = "todo_list.json"

def load_tasks():
    try:
        with open(file_name, "r") as file:
            return json.load(file)
    except:
      return {"tasks": []}

def save_tasks(tasks):
    try:
        with open(file_name, "w") as file:
            json.dump(tasks, file)
    except:
      print("Failed to save.")

def view_tasks(tasks):
    print()
    task_list = tasks["tasks"]
    valid_tasks = []
    invalid_tasks = []
    for task in task_list:
        if isinstance(task, dict) and "description" in task and "complete" in task:
            valid_tasks.append(task)
        else:
            invalid_tasks.append(task)
    if len(valid_tasks) == 0:
        print("No tasks to display.")
    else:
        print("Your To-Do List: ")
        for idx, task in enumerate(valid_tasks):
            status = "[Completed]" if task["complete"] else "[Pending]"
            print(f"{idx + 1}. {task['description']} | {status}")
    if invalid_tasks:
        print("\nWarning: Some invalid tasks were found and ignored:")
        for idx, task in enumerate(invalid_tasks):
            print(f"  {idx + 1}. {task}")

def create_task(tasks):
    description = input("Enter the task description: ").strip()
    if description:
        tasks["tasks"].append({"description": description, "complete": False})
        save_tasks(tasks)
        print("Task added.")
        return load_tasks()  # Reload tasks from file
    else:
        print("Description cannot be empty.")
        return tasks

def mark_task_complete(tasks):
    view_tasks(tasks)
    try:
        task_list = tasks["tasks"]
        task_number = int(input("Enter the task number to mark as complete: ").strip())
        if 1 <= task_number <= len(task_list):
            task_list[task_number - 1]["complete"] = True
            save_tasks(tasks)
            print("Task marked as complete.")
            return load_tasks()  # Reload tasks from file
        else:
            print("Invalid task number.")
            return tasks
    except:
        print("Enter a valid number.")
        return tasks

def main():
    tasks = load_tasks()

    while True:
        print("\nTo-Do List Manager")
        print("1. View Tasks")
        print('2. Add Task')
        print("3. Complete Task")
        print("4. Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            view_tasks(tasks)
        elif choice == "2":
            tasks = create_task(tasks)
        elif choice == "3":
            tasks = mark_task_complete(tasks)
        elif choice == "4":
            print("Goodbye")
            break
        else:
            print("Invalid choice. Please try again.")

main()
