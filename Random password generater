import random
import string # gives access to all characters i.e lower case, upper case, digites etc

# function to generate random password

def generate_random_password():

    # ask for requirements

    length = int(input("Enter the desired pssword length"))
    include_uppercase = input("Include uppercaase letters? (yes/no): ").strip().lower()
    include_special = input("Include special characters letters? (yes/no): ").strip().lower()
    include_digits = input("Include digits? (yes/no): ").strip().lower()

    if length < 4:
        print("Password length must be at least 4 characters.")
        return # this means any code in the line below outside the if loop will not run
    
    lower = string.ascii_lowercase
    uppercase = string.ascii_uppercase if include_uppercase == "yes" else ""
    digit = string.digits if include_digits == "yes" else ""
    special = string.punctuation if include_digits == "yes" else ""
    all_characters = lower+uppercase+digit+special

    required_charaters = []

    if include_uppercase == "yes":
        required_charaters.append(random.choice(uppercase))
    if include_special == "yes":  
        required_charaters.append(random.choice(special))  
    if include_digits == "yes":
        required_charaters.append(random.choice(digit))    

    remaining_length = length - len(required_charaters)   
    password = required_charaters 

    for _ in range(remaining_length):
        character = random.choice(all_characters)
        password.append(character)

    random.shuffle(password)

    str_password = "".join(password) 
    return str_password



password = generate_random_password()   

print(password)




   