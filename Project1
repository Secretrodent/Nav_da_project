# dice roll game


import random

while True:
    
    player_choice = input(f"Do you want to play (y/n) ?  \n").lower()

    if player_choice == 'y' :
        dice1 = random.randint(1,6)
        dice2 = random.randint(1,6)
        print(f'({dice1},{dice2})')
              
    elif player_choice == 'n' :
        print('Thanks for playing ')
        break
    else:
        print("invalid choice matey")    

