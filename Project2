# number guessing game

import random

hidden_number = random.randint(1,10)

while True:

    try:

      user_number = int(input('Enter yo numbah '))

      if hidden_number > user_number:
       print('Too Low ')

      elif user_number > hidden_number:
       print(' Too high') 
     
      else:
       print(' You got it ')
       break

    except ValueError:
     
      print('Invalido numero')
